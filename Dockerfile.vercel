# Laravel 13 + PHP 8.3 + Vite 8 + FrankenPHP
# Vercel detects Dockerfile.vercel at the project root.

FROM node:22-bookworm-slim AS assets

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --include=dev

COPY resources ./resources
COPY public ./public
COPY vite.config.js ./

RUN npm run build


FROM dunglas/frankenphp:php8.3-bookworm AS vendor

WORKDIR /app

RUN install-php-extensions \
    bcmath \
    exif \
    gd \
    intl \
    pdo_mysql \
    pdo_sqlite \
    zip

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY composer.json composer.lock ./
COPY app ./app
COPY bootstrap ./bootstrap
COPY config ./config
COPY database ./database
COPY routes ./routes
COPY artisan ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --no-progress \
    --no-scripts


FROM dunglas/frankenphp:php8.3-bookworm

WORKDIR /app

RUN install-php-extensions \
    bcmath \
    exif \
    gd \
    intl \
    pdo_mysql \
    pdo_sqlite \
    zip

ENV APP_ENV=production \
    APP_DEBUG=false \
    SERVER_NAME=:80

COPY --from=vendor /app/vendor ./vendor
COPY . .

# Copy the production Vite assets generated in the Node build stage.
COPY --from=assets /app/public/build ./public/build

RUN mkdir -p \
    storage/framework/cache \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

# Run Laravel's package discovery after the full application is present.
RUN php artisan package:discover --ansi

EXPOSE 80

# Vercel sends HTTP traffic to port 80 by default.
CMD ["frankenphp", "php-server", "--root", "public"]
